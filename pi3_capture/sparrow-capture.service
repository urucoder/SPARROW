[Unit]
Description=SPARROW USB motion capture with optional edge animal detection
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=sparrow-capture
Group=sparrow-capture
SupplementaryGroups=video
EnvironmentFile=/etc/sparrow-capture/sparrow-capture.env
ExecStart=/opt/sparrow-capture/venv/bin/python /opt/sparrow-capture/motion_capture.py
Restart=always
RestartSec=10
TimeoutStopSec=120
UMask=0027
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
