# SPARROW capture-only configuration (copied to /etc/sparrow-capture/sparrow-capture.env)

# SPARROW server; photos are POSTed to ${SERVER_BASE_URL}/uploads/image
SERVER_BASE_URL=https://server.sparrowstudio.azure.com/v1
ACCESS_KEY_FILE=/etc/sparrow-capture/access_key.txt
UNIQUE_ID_PATH=/etc/unique_id

# USB webcam (list devices with: v4l2-ctl --list-devices)
CAMERA_DEVICE=/dev/video0
CAPTURE_WIDTH=1280
CAPTURE_HEIGHT=720
JPEG_QUALITY=90

# Motion detection
# A pixel counts as changed when it differs from the background by more than this (0-255)
MOTION_PIXEL_THRESHOLD=25
# Fraction of the frame that must change to count as motion (0.01 = 1%)
MOTION_MIN_RATIO=0.01
# Changes larger than this are treated as lighting/exposure changes and ignored
MOTION_MAX_RATIO=0.6
# Consecutive motion frames required before a photo is taken
MOTION_FRAMES=2
# Minimum seconds between two photos
COOLDOWN_SECONDS=5

# Offline queue: photos wait here until uploaded; oldest are dropped above this size
QUEUE_DIR=/var/lib/sparrow-capture/queue
MAX_QUEUE_MB=1024

LOG_LEVEL=INFO

# Optional local MDV6-yolov10-c inference (never uploads unchecked frames).
# The installer enables this when invoked with --edge-model PATH.
EDGE_ENABLED=false
EDGE_MODEL_PATH=/opt/sparrow-capture/models/mdv6-yolov10-c.onnx
# Must differ from QUEUE_DIR; old unchecked captures are never auto-migrated.
EDGE_QUEUE_DIR=/var/lib/sparrow-capture/edge-queue
EDGE_ANIMAL_THRESHOLD=0.5
EDGE_PERSON_THRESHOLD=0.2
EDGE_INTRA_THREADS=2
EDGE_INTER_THREADS=1
